# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# LLM via OpenRouter
LLM_MODEL=minimax/minimax-m3:free
# LLM_MODEL=anthropic/claude-sonnet-4   # alternativa de pago
LLM_API_KEY=sk-or-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (búsqueda semántica en skill --semantic)
# local: sentence-transformers, sin red (requiere pip install sentence-transformers)
# openrouter: API de OpenRouter (usa LLM_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Si EMBEDDING_PROVIDER=openrouter:
# EMBEDDING_OPENROUTER_MODEL=openai/text-embedding-3-small

# Chunks semánticos: fusiona segmentos cortos del mismo hablante antes de embeddir
EMBEDDING_CHUNK_CHARS=300
# Filtros de similitud en la búsqueda (0 desactiva)
EMBEDDING_MIN_SIM=0.0      # piso absoluto de similitud
EMBEDDING_REL_SIM=0.7      # relativo al mejor resultado

# Datos
NOTEKEEPER_DATA=recordings

# Diarización de hablantes (opcional, para `notekeeper diarize`)
# Token de HuggingFace con acceso a pyannote (acepta la licencia en huggingface.co/pyannote/speaker-diarization-community-1)
# HF_TOKEN=hf_xxxx
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# DIARIZATION_DEVICE=auto   # auto | cpu | cuda | mps

# Grabación (opcional)
NOTEKEEPER_SYSTEM_DEVICE=BlackHole 2ch
NOTEKEEPER_MIC_DEVICE=

# GitHub Projects v2 (enviar tareas jira a un panel de proyecto)
# GITHUB_PROJECT_URL: URL del panel, p. ej. https://github.com/users/sightes/projects/9/views/1
# GITHUB_REPO: repo donde se crean los issues (owner/nombre). Vacío = no enviar.
# Requiere gh autenticado con scopes read:project y write:project.
GITHUB_PROJECT_URL=https://github.com/users/sightes/projects/9/views/1
GITHUB_REPO=sightes/project-tracking

# El repo de proyectos también es el destino de ./resume (clonado en ~/Documents/GITHUB/).
# Si quieres un destino distinto, define GITHUB_PROJECT_DIR=... en tu .env local.

# Asignar el issue creado a este usuario (login de GitHub). Vacío = auto-detectar el de `gh`.
GITHUB_ASSIGNEE=sightes

# Estado inicial de las tareas nuevas en el tablero.
# Columnas del panel: Backlog | En Desarrollo | En Gestión | Detenida | Done
GITHUB_STATUS_INITIAL=Backlog
#
# Campos del panel que se rellenan al crear cada tarea (las opciones deben existir en el panel):
# - Prioridad de la tarea (High/Medium/Low) -> opción del campo Priority.
# GITHUB_PRIORITY_MAP=High:P0, Medium:P1, Low:P2
# - story_points de la tarea -> opción del campo Size.
# GITHUB_SIZE_MAP=1:XS, 2:S, 3:S, 5:M, 8:L, 13:XL

