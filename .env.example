# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# LLM via OpenRouter
LLM_MODEL=anthropic/claude-sonnet-4
LLM_API_KEY=sk-or-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (búsqueda semántica en skill --semantic)
# local: sentence-transformers, sin red (requiere pip install sentence-transformers)
# openrouter: API de OpenRouter (usa LLM_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Si EMBEDDING_PROVIDER=openrouter:
# EMBEDDING_OPENROUTER_MODEL=openai/text-embedding-3-small

# Chunks semánticos: fusiona segmentos cortos del mismo hablante antes de embeddir
EMBEDDING_CHUNK_CHARS=300
# Filtros de similitud en la búsqueda (0 desactiva)
EMBEDDING_MIN_SIM=0.0      # piso absoluto de similitud
EMBEDDING_REL_SIM=0.7      # relativo al mejor resultado

# Datos
NOTEKEEPER_DATA=recordings

# Diarización de hablantes (opcional, para `notekeeper diarize`)
# Token de HuggingFace con acceso a pyannote (acepta la licencia en huggingface.co/pyannote/speaker-diarization-community-1)
# HF_TOKEN=hf_xxxx
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# DIARIZATION_DEVICE=auto   # auto | cpu | cuda | mps

# Grabación (opcional)
NOTEKEEPER_SYSTEM_DEVICE=BlackHole 2ch
NOTEKEEPER_MIC_DEVICE=
